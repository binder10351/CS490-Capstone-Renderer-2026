#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D hdrScene;
layout(std430, set = 0, binding = 1) buffer ExposureHistory {
    float adaptedEv;
    float initialized;
} history;
layout(push_constant) uniform Adaptation {
    layout(offset = 20) float deltaSeconds;
    float adaptationSeconds;
    float enabled;
} settings;
void main() {
    if (settings.enabled < 0.5) {
        // Re-enabling auto exposure eases from the manual exposure level.
        history.adaptedEv = 0.0;
        history.initialized = 1.0;
        return;
    }
    vec3 average = textureLod(hdrScene, vec2(0.5), float(textureQueryLevels(hdrScene) - 1)).rgb;
    float luminance = dot(max(average, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
    float targetEv = log2(clamp(0.18 / max(luminance, 1e-4), 1.0 / 256.0, 256.0));
    float weight = 1.0 - exp(-settings.deltaSeconds / max(settings.adaptationSeconds, 0.001));
    // Initialize immediately once, so startup does not fade from an arbitrary exposure.
    history.adaptedEv = history.initialized < 0.5 ? targetEv : mix(history.adaptedEv, targetEv, weight);
    history.initialized = 1.0;
}
